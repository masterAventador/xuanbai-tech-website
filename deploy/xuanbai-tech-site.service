[Unit]
Description=玄白科技官网
After=network.target

[Service]
Type=simple
User=xuanbai-site
Group=xuanbai-site
WorkingDirectory=/opt/xuanbai-tech-site/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
Environment=XUANBAI_DB_PATH=/var/lib/xuanbai-tech-site/contact-leads.sqlite3
Environment=XUANBAI_STATIC_DIR=/opt/xuanbai-tech-site/current/dist/client
ExecStart=/usr/local/bin/node /opt/xuanbai-tech-site/current/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xuanbai-tech-site

[Install]
WantedBy=multi-user.target
