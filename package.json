{
  "name": "xuanbai-tech-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "next build && node scripts/prepare-sites-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "leads:list": "node scripts/list-contact-leads.mjs",
    "lint": "eslint .",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:architecture": "node --test tests/next-architecture.test.mjs",
    "test:server": "node --test tests/contact-server.test.mjs tests/dev-server-lifecycle.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  }
}
